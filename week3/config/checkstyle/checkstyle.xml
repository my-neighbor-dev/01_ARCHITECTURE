<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    detekt.yml의 style 규칙 중 PMD로 커버할 수 없는 규칙을 Checkstyle로 변환.
    - MaxLineLength → LineLength
    - WildcardImport → AvoidStarImport
    - MagicNumber → MagicNumber
    - ForbiddenComment (TODO/FIXME) → TodoComment
-->
<module name="Checker">
    <property name="severity" value="error"/>

    <!-- detekt: MaxLineLength (maxLineLength: 180, excludePackageStatements, excludeImportStatements) -->
    <module name="LineLength">
        <property name="max" value="180"/>
        <property name="ignorePattern" value="^package.*|^import.*"/>
    </module>

    <module name="TreeWalker">

        <!-- detekt: WildcardImport -->
        <module name="AvoidStarImport"/>

        <!-- detekt: MagicNumber (ignoreNumbers: [-1,0,1,2], ignoreHashCodeFunction: true, ignoreAnnotation: true, ignorePropertyDeclaration: false) -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="false"/>
        </module>

        <!-- detekt: ForbiddenComment (TODO:/FIXME: should be addressed before merge) -->
        <module name="TodoComment">
            <property name="format" value="(TODO|FIXME):"/>
        </module>

    </module>
</module>
